--!strict
-- Rockets.luau — catalogue des 40 fusées (GÉNÉRÉ par tools/rockets/gen_luau.py, ne pas éditer à la main).
-- Chaque fusée : identité, monde, stats d'équilibrage, couleur de chaque pièce (nom = nom de l'objet
-- dans le FBX, sans le préfixe RXX_), pièces lumineuses (Neon) et paramètres d'aura.

export type RocketPart = {
	name: string,
	color: Color3,
	glow: boolean,
	metallic: number,
	roughness: number,
}

export type RocketAura = {
	color: Color3,
	strength: number, -- 0.3 (faible) → 3.0 (légendaire)
}

export type RocketDef = {
	id: number,
	key: string,
	name: string,
	world: number,
	finish: string, -- paint | metal | chrome | wood | crystal | matte
	height: number, -- studs
	multiplier: number, -- multiplicateur d'altitude
	cost: number, -- prix en Étoiles (Wins)
	file: string, -- nom du fichier FBX/OBJ dans assets/rockets
	aura: RocketAura,
	parts: { RocketPart },
}

export type WorldDef = {
	id: number,
	name: string,
	subtitle: string,
	color: Color3,
}

